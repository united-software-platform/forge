#!/bin/sh
# Вход плагина forge: единственный исполняемый файл поставки.
#
# Корень поставки вычисляется от разрешённого пути этого файла, а не от рабочего каталога:
# вход работает из любого каталога проекта-потребителя и из кеша установки плагина.
# Корень проекта-потребителя находит ядро (`CLAUDE_PROJECT_DIR`, иначе `.git` вверх).
#
# Вход ничего не пишет в корень плагина: окружение зависимостей собирается в каталоге данных
# плагина (lib/python-env.sh), байт-код не кешируется. Ключ интерпретатора `-P` не добавляет
# рабочий каталог в путь импорта — каталог проекта не может подменить модули ядра.
#
# Коды возврата: 0 — успех; 1 — ввод отвергнут или найдены расхождения; 2 — ошибка вызова
# или окружения.
set -u

self=$(command -v -- "$0") || {
    printf 'forge: не удалось определить путь входа\n' >&2
    exit 2
}
# Вход может быть вызван через символическую ссылку: корень поставки — каталог настоящего файла.
while [ -L "$self" ]; do
    target=$(readlink -- "$self")
    case $target in
        /*) self=$target ;;
        *) self=$(dirname -- "$self")/$target ;;
    esac
done
ROOT=$(cd -- "$(dirname -- "$self")/.." && pwd -P) || exit 2

. "$ROOT/lib/python-env.sh"
prepare_python_env "$ROOT" || exit 2

PYTHONPATH="$ROOT/src"
PYTHONDONTWRITEBYTECODE=1
export PYTHONPATH PYTHONDONTWRITEBYTECODE

exec "$PY" -P -m forge_model "$@"
